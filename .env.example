# ── Server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8001
LOG_LEVEL=INFO

# ── Database (Postgres / Supabase) — shared with tojibox-scraper ───────────
DB_HOST=your-project.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_NAME=postgres

# ── GIWA chain (GIWA Sepolia testnet, OP-Stack EVM L2) ──────────────────────
GIWA_RPC_URL=https://sepolia-rpc.giwa.io/
GIWA_CHAIN_ID=91342
GIWA_EXPLORER_URL=https://sepolia-explorer.giwa.io

# Oracle wallet — signs report seals (ECDSA/EIP-191) and mints on-chain
# report receipts via chain/client.py. Never commit the real value.
GIWA_ORACLE_PRIVATE_KEY=your_giwa_wallet_private_key_here
GIWA_ORACLE_ADDRESS=0xYourOracleWalletAddressHere

# Deployed TojiboxReportReceipt contract address (see contracts/)
TOJIBOX_REPORT_RECEIPT_ADDRESS=0xDeployedContractAddressHere

# Optional ENS name for the oracle — none registered yet for Tojibox
ORACLE_ENS=

# ── x402 payment gate ────────────────────────────────────────────────────────
# Price to unlock GET /parcels/{pin}/history, in wei.
# Default: 100000000000000 wei = 0.0001 ETH
X402_PRICE_WEI=100000000000000

# ── MCP server (mcp/server.js) ──────────────────────────────────────────────
ORACLE_URL=http://localhost:8001
# Wallet the MCP server pays x402 from autonomously (can be the same as
# GIWA_ORACLE_PRIVATE_KEY above, or a separate funded testnet key)
GIWA_PRIVATE_KEY=your_giwa_wallet_private_key_here

# ENS resolution (Ethereum L1, unrelated to GIWA) — used by mcp/server.js's
# lookup_ens tool
ETH_NETWORK=mainnet
ETH_RPC_URL=
